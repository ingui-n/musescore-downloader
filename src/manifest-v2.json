{
  "manifest_version": 2,
  "name": "Music Score Downloader",
  "description": "Extension allowing you to download music sheets, audio and midi files for free",
  "version": "0.5.20",
  "browser_specific_settings": {
    "gecko": {
      "id": "@extension-without-data-collection",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "declarativeNetRequest",
    "storage",
    "https://*.musescore.com/*",
    "https://s3.ultimate-guitar.com/musescore.scoredata/g/*",
    "https://cdn.ustatik.com/*",
    "https://*.wasabisys.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.musescore.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "content.css"
  ]
}
